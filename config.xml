<?xml version='1.0' encoding='utf-8'?>
<widget id="com.Manager.Manager" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Manager</name>
    <description>
        A sample Apache Cordova application that responds to the deviceready event.
    </description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />

    <!-- Libera fetch/XHR pra qualquer domínio (necessário pra baixar o
         Raw JSON e as playlists M3U de servidores externos). -->
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <!-- Android 9+ bloqueia HTTP puro (não-HTTPS) por padrão. Muitos
         servidores IPTV ainda servem playlists via http://, então isso
         precisa estar habilitado ou o fetch falha silenciosamente
         (net::ERR_CLEARTEXT_NOT_PERMITTED) mesmo com o access/navigation
         acima corretos. -->

    <platform name="android">
        <allow-intent href="market:*" />
        <!-- Reforça o cleartext diretamente no AndroidManifest.xml gerado,
             já que a preference sozinha nem sempre é suficiente dependendo
             da versão do cordova-android. -->
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
    </platform>

    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
</widget>
