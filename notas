<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sala de Controle</title>
<style>
  :root{
    --bg:#12151b;
    --bg-elev:#242a34;
    --bg-elev-2:#2d3542;
    --border:#454f60;
    --border-soft:#3a4250;
    --text:#eef1f5;
    --text-dim:#a7b1bf;
    --text-faint:#78828f;
    --accent:#ffb454;
    --danger:#e0716b;
    --add-green:#5fd18a;
    --link:#5cadff;
    --font-ui: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    --font-mono: ui-monospace, "Cascadia Mono", Consolas, "SFMono-Regular", Menlo, monospace;
  }
  *{box-sizing:border-box;}
  html,body{height:100%; margin:0; padding:0; scrollbar-width:none; -ms-overflow-style:none;}
  html::-webkit-scrollbar, body::-webkit-scrollbar{ width:0; height:0; display:none; }
  body{ margin:0; background:var(--bg); color:var(--text); font-family:var(--font-ui); font-size:14px; line-height:1.5; }
  a{color:var(--link); cursor:pointer;}
  .hidden{display:none !important;}

  header{ position:fixed; top:0; left:0; right:0; z-index:20; background:var(--bg-elev); border-bottom:1px solid var(--border); }
  .tab-strip-wrap{ display:flex; align-items:flex-end; }
  .tab-strip{ display:flex; align-items:flex-end; gap:4px; padding:8px 6px 0 14px; overflow-x:auto; overflow-y:hidden; scrollbar-width:none; -ms-overflow-style:none; flex:1; min-width:0; }
  .tab-strip::-webkit-scrollbar{ display:none; height:0; }
  .tab{
    display:flex; align-items:center; max-width:220px;
    background:var(--bg-elev-2); border:1px solid var(--border);
    border-radius:8px 8px 0 0; padding:7px 10px; cursor:pointer; color:var(--text-dim);
    margin-bottom:-1px; user-select:none; gap:4px;
  }
  .tab.active{ background:var(--bg); color:var(--text); border-bottom-color:var(--bg); }
  .tab.drop-target{ outline:2px solid var(--accent); outline-offset:-2px; }
  .tab-lock{ background:none; border:none; color:var(--text-dim); cursor:pointer; font-size:12px; padding:0; flex:0 0 auto; }
  .tab-lock:hover{ color:var(--accent); }
  .tab-title{ max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; outline:none; font-size:13px; }
  .tab-add{ background:none; border:none; color:var(--text-faint); width:28px; height:31px; cursor:pointer; font-size:16px; margin-bottom:1px; flex:0 0 auto; margin-right:6px; }
  .tab-add:hover{ color:var(--accent); }

  main{ padding:0; margin-top:48px; }
  #page-content{
    position:relative; min-height:200px;
    background-image: radial-gradient(var(--border-soft) 1px, transparent 1px);
    background-size:20px 20px;
  }

  .copy-page{ padding:30px 20px; max-width:640px; margin:0 auto; }
  .copy-page-hint{ color:var(--text-faint); font-size:12.5px; margin-bottom:10px; }
  .copy-textarea{
    width:100%; min-height:220px; background:var(--bg-elev); border:1px solid var(--border); border-radius:6px;
    color:var(--text); padding:14px 16px; font-family:var(--font-mono); font-size:12.5px; outline:none; resize:vertical;
  }
  .copy-textarea:focus{ border-color:var(--accent); }
  .copy-locked-placeholder{
    padding:60px 20px; text-align:center; color:var(--text-faint); border:1px dashed var(--border); border-radius:8px; font-size:13px;
  }

  .block{ position:absolute; }

  /* ---------- text block: free width+height resize from one corner ---------- */
  .editable{ outline:none; }
  .text-body{
    width:100%; background:var(--bg-elev); border-radius:6px; padding:14px 16px; min-height:100px; line-height:1.65;
    overflow-wrap:break-word; word-break:break-word; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,.35);
  }
  .text-block{ width:300px; }
  .block.fixed-size .text-body{ height:100%; }
  .resize-handle{
    position:absolute; right:-6px; bottom:-6px; width:15px; height:15px; cursor:nwse-resize;
    opacity:0; z-index:11; background:var(--bg-elev-2); border:1px solid var(--border); border-radius:4px;
    background-image:linear-gradient(135deg, transparent 45%, var(--text-faint) 45%, var(--text-faint) 55%, transparent 55%);
  }
  .block:hover .resize-handle{ opacity:.85; }
  .block.resizing .resize-handle, .block.selected .resize-handle{ opacity:1 !important; }
  .resize-handle:hover{ opacity:1 !important; }
  .text-body ul,.text-body ol{ padding-left:22px; margin:6px 0; }
  .text-body hr{ border:none; border-top:1px solid var(--border); margin:10px 0; }
  .text-body code{ background:#232830; color:#eab676; padding:1px 5px; border-radius:4px; font-family:var(--font-mono); font-size:12.5px; }
  .code-embed{
    background:#0e1116; border:1px solid var(--border); border-radius:6px; margin:6px 0;
    padding:6px 0; overflow-x:auto; counter-reset:codeline; font-family:var(--font-mono); font-size:12.5px;
  }
  .code-embed-line{
    counter-increment:codeline; position:relative; padding:1px 10px 1px 40px; white-space:pre; color:#d8dee6; min-height:1.5em;
  }
  .code-embed-line::before{
    content:counter(codeline); position:absolute; left:0; top:1px; width:30px; text-align:right; padding-right:8px;
    color:var(--text-faint); user-select:none;
  }
  details.exp-box{ border:1px solid var(--border); border-radius:6px; margin:6px 0; padding:6px 10px; background:var(--bg-elev-2); }
  details.exp-box summary{ cursor:pointer; color:var(--text-dim); font-size:12.5px; }
  details.exp-box[open] summary{ margin-bottom:6px; }

  /* ---------- table block: handles measured via JS, outside the table ---------- */
  .table-gutter{ display:inline-block; padding:34px 0 0 34px; }
  .table-zoom table{ box-shadow:0 1px 4px rgba(0,0,0,.35); }
  .table-zoom{ display:inline-block; }
  .editable-table{ border-collapse:collapse; }
  .tcell{ border:1px solid var(--border-soft); min-width:60px; background:var(--bg-elev); padding:0; transition:background .1s; }
  .tcell.hl-danger{ background:rgba(224,113,109,.22); }
  .tcell-content{ padding:8px 12px; min-height:1.3em; outline:none; overflow-wrap:break-word; word-break:break-word; }
  .tcell:focus-within{ background:var(--bg-elev-2); }
  .tcell-content code{ background:#232830; color:#eab676; padding:1px 5px; border-radius:4px; font-family:var(--font-mono); font-size:12px; }

  .handle-zone{
    position:absolute; width:28px; height:28px; transform:translate(-50%,-50%);
    display:flex; align-items:center; justify-content:center; cursor:pointer; z-index:15;
  }
  .handle-zone .handle{
    width:16px; height:16px; border-radius:50%; border:1px solid var(--border); background:var(--bg-elev-2);
    color:var(--text-faint); font-size:12px; font-weight:600; line-height:1; display:flex; align-items:center; justify-content:center;
    opacity:0; transition:opacity .12s ease, background .12s ease, color .12s ease; pointer-events:none;
  }
  .handle-zone:hover .handle{ opacity:1; background:var(--bg-elev); color:var(--text); }
  .handle-zone.zone-add:hover .handle{ background:rgba(95,209,138,.2); color:var(--add-green); border-color:var(--add-green); }
  .handle-zone.zone-del:hover .handle{ background:rgba(224,113,109,.2); color:var(--danger); border-color:var(--danger); }
  .handle-zone.is-disabled:hover .handle{ opacity:.3; }
  .insert-preview-line{ position:absolute; background:var(--add-green); z-index:16; pointer-events:none; border-radius:2px; opacity:.85; }
  .col-resize-strip{ position:absolute; width:10px; transform:translateX(-50%); cursor:col-resize; z-index:14; }
  .col-resize-strip::after{ content:''; position:absolute; left:50%; top:0; bottom:0; width:2px; transform:translateX(-50%); background:transparent; }
  .col-resize-strip:hover::after{ background:var(--text-faint); }
  .zoom-resize-grip{
    position:absolute; width:20px; height:20px; border-radius:6px; border:1px solid var(--border);
    background:var(--bg-elev-2); color:var(--text-faint); cursor:nwse-resize; z-index:16;
    display:flex; align-items:center; justify-content:center; font-size:11px;
  }
  .zoom-resize-grip:hover{ background:var(--bg-elev); color:var(--text); }
  .open-all-btn{
    position:absolute; top:-16px; right:-6px; width:26px; height:22px; border-radius:6px;
    background:var(--bg-elev-2); border:1px solid var(--border); color:var(--link); font-size:14px; line-height:20px; text-align:center;
    cursor:pointer; user-select:none; z-index:18;
  }
  .open-all-btn:hover{ color:#eafff2; background:var(--bg-elev); }

  /* ---------- code block ---------- */
  .code-block{ width:380px; }
  .code-wrap{ display:flex; background:#0e1116; border:1px solid var(--border); border-radius:6px; overflow:hidden; align-items:flex-start; box-shadow:0 1px 4px rgba(0,0,0,.35); }
  .code-linenums{ background:#12151b; color:var(--text-faint); font-family:var(--font-mono); font-size:12.5px; line-height:1.55; padding:10px 8px; text-align:right; user-select:none; }
  .code-editor{
    flex:1; background:transparent; border:none; color:#d8dee6; font-family:var(--font-mono);
    font-size:12.5px; line-height:1.55; padding:10px 10px; resize:none; outline:none;
    white-space:pre-wrap; overflow-wrap:anywhere; overflow:hidden; min-width:0;
  }
  .code-resize-e{
    position:absolute; right:-4px; top:18px; bottom:18px; width:7px; cursor:ew-resize; opacity:0;
    background:var(--text-faint); border-radius:3px; z-index:11;
  }
  .block:hover .code-resize-e{ opacity:.7; }
  .code-resize-e:hover{ opacity:1 !important; }

  /* ---------- shared block chrome ---------- */
  .block-handle{
    position:absolute; top:-4px; left:-4px; width:20px; height:18px; border-radius:4px 0 6px 0;
    background:var(--bg-elev-2); color:#c7cdd6; font-size:12px; line-height:18px; text-align:center;
    cursor:grab; user-select:none; z-index:17;
  }
  .block.selected .block-handle{ color:var(--accent); }
  .block.dragging{ box-shadow:0 12px 30px rgba(0,0,0,.45); z-index:200; }
  .block.dragging .block-handle{ cursor:grabbing; }
  .block.selected{ outline:1px solid var(--accent); outline-offset:3px; border-radius:6px; }

  .drag-ghost{ box-shadow:0 14px 34px rgba(0,0,0,.5); opacity:.85; pointer-events:none; z-index:1000; }

  .reconnect-banner{
    position:fixed; top:48px; left:0; right:0; z-index:60; background:var(--accent); color:#241b06;
    display:flex; align-items:center; justify-content:center; gap:12px; padding:8px 14px; font-size:13px; font-weight:600;
  }
  .reconnect-banner button{
    background:#241b06; color:var(--accent); border:none; padding:5px 12px; border-radius:5px; cursor:pointer; font-size:12.5px; font-weight:700;
  }
  .reconnect-banner button:hover{ opacity:.85; }

  .undo-redo-bar{ position:fixed; top:48px; left:14px; z-index:30; display:flex; gap:4px; }  .undo-redo-bar button{
    width:26px; height:26px; border-radius:6px; border:1px solid var(--border); background:var(--bg-elev-2);
    color:var(--text-dim); cursor:pointer; font-size:14px; display:flex; align-items:center; justify-content:center;
  }
  .undo-redo-bar button:hover:not(:disabled){ background:var(--bg-elev); color:var(--text); }
  .undo-redo-bar button:disabled{ opacity:.3; cursor:default; }

  .search-panel{
    position:fixed; top:54px; right:14px; z-index:70; background:var(--bg-elev-2); border:1px solid var(--border);
    border-radius:8px; padding:7px; box-shadow:0 8px 24px rgba(0,0,0,.4); display:flex; flex-direction:column; gap:5px;
  }
  .search-row{ display:flex; align-items:center; gap:4px; }
  .search-row input{
    background:var(--bg-elev); border:1px solid var(--border); color:var(--text); border-radius:4px;
    padding:5px 8px; font-size:13px; width:170px; outline:none;
  }
  .search-row input:focus{ border-color:var(--accent); }
  .search-count{ font-size:11.5px; color:var(--text-faint); min-width:40px; text-align:center; }
  .search-row button{
    width:24px; height:24px; border-radius:4px; border:1px solid var(--border); background:var(--bg-elev);
    color:var(--text-dim); cursor:pointer; font-size:12px; display:flex; align-items:center; justify-content:center; flex:0 0 auto;
  }
  .search-row button:hover{ background:var(--bg-elev-2); color:var(--text); }
  .search-text-btn{ width:auto !important; padding:0 8px; font-size:11.5px; }
  mark.search-hit{ background:#5a4a1a; color:#ffd54a; border-radius:2px; }
  mark.search-hit.current{ background:var(--accent); color:#1a1a1a; }

  .status-dot{
    position:fixed; bottom:16px; right:16px; width:9px; height:9px; border-radius:50%;
    background:var(--text-faint); cursor:pointer; z-index:40; box-shadow:0 0 0 5px rgba(0,0,0,.22);
  }
  .status-dot.ok{ background:#5cb88a; }
  .status-dot.warn{ background:var(--accent); }
  .status-dot.danger{ background:var(--danger); }

  #toast{
    position:fixed; bottom:36px; right:16px; background:var(--bg-elev-2); color:var(--text); border:1px solid var(--border);
    padding:8px 14px; border-radius:6px; font-size:12.5px; opacity:0; transform:translateY(6px);
    transition:opacity .15s, transform .15s; pointer-events:none; z-index:90;
  }
  #toast.show{ opacity:1; transform:translateY(0); }

  .ctx-menu{
    position:fixed; z-index:80; background:var(--bg-elev-2); border:1px solid var(--border); border-radius:6px;
    padding:5px; min-width:200px; box-shadow:0 8px 24px rgba(0,0,0,.4); max-height:80vh; overflow-y:auto;
  }
  .ctx-menu button{
    display:block; width:100%; text-align:left; background:none; border:none; color:var(--text);
    padding:7px 10px; border-radius:4px; cursor:pointer; font-size:13px;
  }
  .ctx-menu button:hover{ background:var(--bg-elev); }
  .ctx-sep{ height:1px; background:var(--border); margin:5px 3px; }
</style>
</head>
<body>

<header>
  <div class="tab-strip-wrap">
    <div id="tab-strip" class="tab-strip"></div>
    <button class="tab-add" id="tab-add-btn" title="Nova página">+</button>
  </div>
</header>

<main>
  <div id="page-content"></div>
</main>

<div id="reconnect-banner" class="reconnect-banner hidden">
  <span>O navegador precisa de um clique seu pra continuar salvando neste arquivo.</span>
  <button id="reconnect-banner-btn">Continuar salvando</button>
</div>

<div id="undo-redo" class="undo-redo-bar">
  <button id="undo-btn" title="Desfazer (Ctrl+Z)" disabled>↺</button>
  <button id="redo-btn" title="Refazer (Ctrl+Shift+Z)" disabled>↻</button>
</div>

<div id="search-panel" class="search-panel hidden">
  <div class="search-row">
    <input id="search-input" type="text" placeholder="Buscar (\n = quebra de linha)">
    <span id="search-count" class="search-count">0/0</span>
    <button id="search-prev" title="Anterior (Shift+Enter)">↑</button>
    <button id="search-next" title="Próximo (Enter)">↓</button>
    <button id="search-close" title="Fechar (Esc)">✕</button>
  </div>
  <div class="search-row hidden" id="replace-row">
    <input id="replace-input" type="text" placeholder="Substituir por">
    <button id="replace-one" class="search-text-btn" title="Substituir esta ocorrência">Substituir</button>
    <button id="replace-all" class="search-text-btn" title="Substituir todas">Tudo</button>
  </div>
</div>

<div id="status-dot" class="status-dot" title=""></div>
<div id="toast"></div>
<div id="ctx-menu" class="ctx-menu hidden"></div>
<input type="file" id="import-input" accept="application/json" class="hidden">

<script id="app-data" type="application/json"></script>
<script>
(function(){
  "use strict";

  const LS_KEY = 'sala_de_controle_data_v13';
  const GRID = 20;
  let fileHandle = null;
  let saveTimer = null;
  let lastEditable = null;
  let clickTimer = null;
  let currentCtxItems = null;
  let selectedBlockId = null;
  let dragState = null;
  let spawnCounter = 0;
  let toastTimer = null;
  let undoStack = [];
  let redoStack = [];
  let lastSnapshot = null;
  let undoDebounceTimer = null;
  const MAX_UNDO = 60;
  let searchState = null;
  let dbNS = null;
  const fileSupport = typeof window.showOpenFilePicker === 'function';

  function uid(){ return 'id' + Math.random().toString(36).slice(2, 10); }
  function esc(str){
    return String(str == null ? '' : str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
  function encodeData(obj){ return JSON.stringify(obj).replace(/</g, '\\u003C'); }
  function showToast(msg){
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 1800);
  }

  function defaultData(){
    const p1 = uid();
    return { version: 13, activePageId: p1, pages: [ { id: p1, title: 'Página 1', blocks: [ {id: uid(), type: 'text', x:40, y:40, html: ''} ] } ] };
  }
  function normalize(d){
    if(!d.pages || !d.pages.length) d.pages = [{id: uid(), title: 'Página 1', blocks: []}];
    if(!d.activePageId || !d.pages.find(p => p.id === d.activePageId)) d.activePageId = d.pages[0].id;
    d.pages.forEach(p => {
      if(!p.blocks) p.blocks = [];
      p.blocks.forEach((b, i) => {
        if(typeof b.x !== 'number') b.x = 40 + (i % 6) * 24;
        if(typeof b.y !== 'number') b.y = 40 + (i % 6) * 24;
      });
    });
    return d;
  }
  function emptyData(){ return normalize({version:13, pages:[], activePageId:null}); }

  let loadedFromFallback = false;
  function loadInitialData(){
    try{
      const tag = document.getElementById('app-data');
      const raw = (tag.textContent || '').trim();
      if(raw){ const d = JSON.parse(raw); if(d && d.pages) return normalize(d); }
    }catch(e){ console.warn('Falha ao ler dados do arquivo:', e); }
    // Try this exact version's key first...
    try{
      const ls = localStorage.getItem(LS_KEY);
      if(ls){ const d = JSON.parse(ls); if(d && d.pages && d.pages.length){ loadedFromFallback = true; return normalize(d); } }
    }catch(e){}
    // ...then fall back to ANY other version of this app's storage the browser has saved,
    // in case the internal version tag changed between when you typed the data and now.
    try{
      let best = null;
      for(let i = 0; i < localStorage.length; i++){
        const key = localStorage.key(i);
        if(!key || !key.startsWith('sala_de_controle_data') || key === LS_KEY) continue;
        try{
          const d = JSON.parse(localStorage.getItem(key));
          if(d && d.pages && d.pages.length) best = d;
        }catch(e){}
      }
      if(best){ loadedFromFallback = true; return normalize(best); }
    }catch(e){}
    return normalize(defaultData());
  }

  let appData = loadInitialData();

  function findPage(id){ return appData.pages.find(p => p.id === id); }
  function findBlock(pageId, blockId){ const p = findPage(pageId); return p && p.blocks.find(b => b.id === blockId); }

  // ---------- persistence ----------
  function buildHTMLSnapshot(){
    document.getElementById('app-data').textContent = encodeData(appData);
    return '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
  }
  async function verifyPermission(handle, write){
    const opts = write ? {mode:'readwrite'} : {};
    try{
      if((await handle.queryPermission(opts)) === 'granted') return true;
      if((await handle.requestPermission(opts)) === 'granted') return true;
    }catch(e){}
    return false;
  }
  async function saveToFile(){
    if(!fileHandle) return;
    try{
      const ok = await verifyPermission(fileHandle, true);
      if(!ok){ setConnStatus('pending'); return; }
      const writable = await fileHandle.createWritable();
      await writable.write(buildHTMLSnapshot());
      await writable.close();
      setConnStatus(true);
    }catch(e){ console.warn('Erro ao salvar no arquivo:', e); setConnStatus('error'); }
  }
  function schedule(){
    try{ localStorage.setItem(LS_KEY, JSON.stringify(appData)); }catch(e){}
    clearTimeout(saveTimer);
    if(dbNS){
      setConnStatus('saving');
      saveTimer = setTimeout(() => {
        dbNS.doc('app/state').set(appData).then(() => setConnStatus('db')).catch(() => setConnStatus('error'));
      }, 500);
      return;
    }
    if(fileHandle) setConnStatus('saving');
    saveTimer = setTimeout(() =
